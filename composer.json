{
    "name": "mygento/jeeves",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nikita Tarasov",
            "email": "nikita@mygento.ru"
        }
    ],
    "description": "cli tool to generate M2 code",
    "require": {
        "symfony/console": "^6.0",
        "symfony/filesystem": "^6.0",
        "symfony/yaml": "^6.0",
        "sabre/xml": "^4.0",
        "nette/php-generator": "^4.1",
        "consolidation/self-update": "^2.2.0",
        "mygento/coding-standard": "~2.14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": { "Mygento\\Jeeves\\": "src/Jeeves" }
    },
    "config": {
        "platform": {
            "php": "8.1.20"
        },
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "bin": ["bin/jeeves"]
}
